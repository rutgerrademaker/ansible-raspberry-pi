http:
  routers:
    {{ app_name }}:
      rule: "Host(`{{ subdomain }}.{{ public_domain }}_"
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      service: {{ app_name }}
  
    {{ app_name }}:
      rule: "Host(`{{ subdomain }}.{{ public_domain }})"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: {{ app_name }}
    
  middlewares:
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    '{{ app_name }}':
      loadBalancer:
        servers:
          - url: "http://10.0.0.53:{{ docker_port_http }}"
