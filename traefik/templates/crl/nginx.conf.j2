worker_processes 1;

events { worker_connections 1024; }

http {
    server {
        listen 80;
        listen 443 ssl;
        server_name ca.{{ cert_domain }};

        ssl_certificate     /etc/nginx/certs/{{ cert_domain }}-fullchain.crt;
        ssl_certificate_key /etc/nginx/certs/{{ cert_domain }}.key;

        # Serve CRL at /crl.pem
        location /crl.pem {
            alias /usr/share/nginx/html/{{ cert_domain }}.crl;
            default_type application/pkix-crl;
        }

        # Serve crt at /home.arpa.crt
        location /home.arpa.crt {
            alias /usr/share/nginx/html/{{ cert_domain }}.crt;
            default_type text/html; charset=utf-8
        }
    }
}
